{
  "name": "@sudobility/mail_box_types",
  "version": "1.0.31",
  "description": "TypeScript types for Mail Box services - indexer, WildDuck, and KYC",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CLAUDE.md"
  ],
  "keywords": [
    "typescript",
    "types",
    "mail-box",
    "indexer",
    "wildduck",
    "kyc"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/types": "^1.9.75",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "peerDependencies": {
    "@sudobility/types": "^1.9.75"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/mail_box_types.git"
  }
}
